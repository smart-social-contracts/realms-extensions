{
  "name": "managed_services",
  "version": "0.2.0",
  "description": "See your realm's current software version, install updates when available, buy credits, and review spending on upgrades and top-ups.",
  "author": "Realms Team",
  "ggg_api_version": 1,
  "permissions": [],
  "functions": [
    "get_config",
    "get_transactions",
    "set_config"
  ],
  "async_functions": [
    "get_transactions"
  ],
  "capabilities": [
    "realm.info",
    "ext_entity.list",
    "ext_entity.create",
    "ext_entity.update",
    "service.call:registry.get_transactions"
  ],
  "entities": {
    "ManagedServicesConfig": {
      "alias": "key",
      "fields": {
        "key": {
          "type": "String",
          "max_length": 256
        },
        "value": {
          "type": "String"
        }
      }
    }
  },
  "profiles": [
    "admin",
    "operator"
  ],
  "categories": [
    "realm_management"
  ],
  "sidebar_label": {
    "en": "Managed Services",
    "es": "Servicios Gestionados",
    "de": "Verwaltete Dienste",
    "fr": "Services Gérés",
    "it": "Servizi Gestiti",
    "zh-CN": "托管服务",
    "ca-valencia": "Serveis Gestionats"
  },
  "icon": "cloud_upload",
  "doc_url": "https://github.com/smart-social-contracts/realms-extensions/tree/main/extensions/managed_services",
  "show_in_sidebar": true,
  "entry_access": {
    "default": "realm.configure.infrastructure"
  }
}
