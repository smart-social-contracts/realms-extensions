{
  "name": "realm_settings",
  "version": "1.10.7",
  "description": "Change your realm's name, welcome message, languages, and branding; control who can join; set voting rules, currency, notifications, lifecycle stage, and apply or destroy department-table JSON.",
  "author": "Realms Team",
  "categories": [
    "realm_management"
  ],
  "sidebar_label": {
    "en": "Realm Settings"
  },
  "permissions": [
    "admin"
  ],
  "profiles": [
    "admin"
  ],
  "show_in_sidebar": true,
  "icon": "settings",
  "entry_access": {
    "default": "realm.configure",
    "functions": {
      "health": "public",
      "request_quarter_scale": "quarter.register",
      "set_realm_stage": {
        "level": "realm.configure",
        "governed": true
      },
      "transfer_root": {
        "level": "realm.admin",
        "governed": true
      },
      "set_quarter_policy": {
        "level": "org.set_policy",
        "governed": true
      },
      "patch_manifest_data": {
        "level": "realm.configure",
        "governed": true
      },
      "set_trust_policy": {
        "level": "realm.configure.trust_policy",
        "governed": true
      },
      "apply_department_table": "organization.add",
      "delete_department": "organization.delete"
    }
  }
}
