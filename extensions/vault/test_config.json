{
  "$schema": "../_shared/testing/config/test_config.schema.json",
  "extension_id": "vault",
  "test_type": "full",
  "realm_config": {
    "citizens": 5,
    "organizations": 2,
    "random": false
  },
  "test_canisters": {
    "enabled": false
  },
  "backend_tests": {
    "enabled": false
  },
  "e2e_tests": {
    "enabled": true,
    "base_path": "/extensions/vault",
    "specs": "tests/e2e/specs/**/*.spec.ts",
    "config": "tests/e2e/playwright.config.ts",
    "warmup": true
  },
  "linting": {
    "enabled": false
  },
  "docker": {
    "image": "ghcr.io/smart-social-contracts/realms:ui-test-latest",
    "container_name_prefix": "vault-test",
    "port_mapping": {
      "host_port": 8001,
      "container_port": 8000
    }
  },
  "environment": {
    "PLAYWRIGHT_BASE_URL": "http://localhost:8000",
    "E2E_WARMUP_PATH": "/extensions/vault"
  }
}
