{
  "name": "justice_litigation",
  "version": "0.5.1",
  "ggg_api_version": 1,
  "description": "File a private dispute with the justice department, follow it through your realm's courts, and resolve or appeal cases if you oversee justice.",
  "permissions": [],
  "entry_points": [
    "initialize",
    "get_my_roles",
    "get_justice_systems",
    "get_courts",
    "create_court",
    "seed_default_courts",
    "get_judges",
    "get_cases",
    "get_case",
    "file_case",
    "assign_judge",
    "get_verdicts",
    "issue_verdict",
    "get_penalties",
    "execute_penalty",
    "waive_penalty",
    "get_appeals",
    "file_appeal",
    "decide_appeal",
    "get_statistics",
    "get_litigations",
    "create_litigation",
    "set_litigation_content",
    "get_justice_audience"
  ],
  "profiles": [
    "admin",
    "member"
  ],
  "categories": [
    "public_services"
  ],
  "sidebar_label": {
    "en": "Justice"
  },
  "icon": "gavel",
  "doc_url": "https://github.com/smart-social-contracts/realms-extensions/tree/main/extensions/justice_litigation",
  "show_in_sidebar": true,
  "capabilities": [
    "justice.roles",
    "justice.audience",
    "justice.justice_systems",
    "justice.courts",
    "justice.judges",
    "justice.cases",
    "justice.case",
    "justice.litigations",
    "justice.verdicts",
    "justice.penalties",
    "justice.appeals",
    "justice.statistics",
    "justice.initialize",
    "justice.seed_courts",
    "justice.create_court",
    "justice.file_case",
    "justice.assign_judge",
    "justice.create_litigation",
    "justice.set_litigation_content",
    "justice.issue_verdict",
    "justice.execute_penalty",
    "justice.waive_penalty",
    "justice.file_appeal",
    "justice.decide_appeal"
  ],
  "entities": {
    "LitigationContent": {
      "alias": "case_id",
      "fields": {
        "case_id": { "type": "String", "max_length": 64 },
        "ciphertext": { "type": "String" },
        "scope": { "type": "String", "max_length": 512 },
        "created_by": { "type": "String", "max_length": 128 }
      }
    }
  },
  "entry_access": {
    "default": "dispute.view",
    "functions": {
      "initialize": "realm.admin",
      "create_court": "realm.admin",
      "seed_default_courts": "realm.admin",
      "file_case": "dispute.create",
      "file_appeal": "dispute.create",
      "create_litigation": "dispute.create",
      "set_litigation_content": "dispute.create",
      "get_justice_audience": "dispute.create",
      "assign_judge": "dispute.assign",
      "issue_verdict": "resolution.issue",
      "execute_penalty": "fine.apply",
      "waive_penalty": "fine.apply",
      "decide_appeal": "appeal.allow"
    }
  }
}
