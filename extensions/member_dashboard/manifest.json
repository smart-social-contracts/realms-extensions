{
  "name": "member_dashboard",
  "version": "1.1.2",
  "description": "Personal dashboard for members to manage their government services and documents",
  "author": "Smart Social Contracts",
  "system": true,
  "runtime": "sandboxed",
  "sdk_version": "1",
  "capabilities": [
    "call_extension",
    "navigate",
    "notify"
  ],
  "permissions": [],
  "profiles": [
    "member",
    "admin"
  ],
  "categories": [
    "public_services"
  ],
  "sidebar_label": {
    "en": "My Dashboard"
  },
  "icon": "layout-dashboard",
  "doc_url": "https://github.com/smart-social-contracts/realms-extensions/tree/main/extensions/member_dashboard",
  "show_in_sidebar": true,
  "is_default": true,
  "entry_access": {
    "default": "self.data_view",
    "functions": {
      "get_dashboard_summary": "self.data_view",
      "get_public_services": "self.data_view",
      "get_citizenship_status": "self.data_view",
      "get_tax_information": "self.data_view",
      "get_invoice_information": "self.data_view",
      "get_vault_address": "self.data_view",
      "get_invoice_deposit_address": "self.data_view",
      "get_personal_data": "self.data_view",
      "list_payment_accounts": "self.data_view",
      "add_payment_account": "self.data_manage",
      "remove_payment_account": "self.data_manage",
      "check_invoice_payment": "self.invoice_refresh",
      "demo_mark_invoice_paid": "demo.manage"
    }
  }
}
