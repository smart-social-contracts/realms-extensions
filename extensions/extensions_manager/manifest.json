{
  "name": "extensions_manager",
  "version": "1.1.0",
  "deprecated": true,
  "description": "DEPRECATED — extension access control moved to role_manager; package operations live in package_manager",
  "author": "Realms Team",
  "categories": [
    "settings"
  ],
  "sidebar_label": {
    "en": "Menus"
  },
  "permissions": [
    "admin"
  ],
  "profiles": [
    "admin"
  ],
  "show_in_sidebar": false,
  "icon": "puzzle",
  "entry_access": {
    "default": "realm.admin",
    "functions": {
      "grant_extension_to_user": {
        "level": "role.assign",
        "governed": true
      },
      "revoke_extension_from_user": {
        "level": "role.revoke",
        "governed": true
      },
      "grant_extension_to_department": {
        "level": "role.assign",
        "governed": true
      },
      "revoke_extension_from_department": {
        "level": "role.revoke",
        "governed": true
      },
      "grant_extension_to_profile": {
        "level": "role.assign",
        "governed": true
      },
      "revoke_extension_from_profile": {
        "level": "role.revoke",
        "governed": true
      }
    }
  }
}
