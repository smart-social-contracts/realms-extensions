{
  "$schema": "../_shared/testing/config/test_config.schema.json",
  "extension_id": "passport_verification",
  "test_type": "full",

  "realm_config": {
    "citizens": 2,
    "random": false
  },

  "test_canisters": {
    "enabled": false
  },

  "backend_tests": {
    "enabled": false
  },

  "e2e_tests": {
    "enabled": false,
    "base_path": "/extensions/passport_verification",
    "warmup": true
  },

  "linting": {
    "enabled": true,
    "black": true,
    "isort": true,
    "flake8": true,
    "mypy": false
  },

  "docker": {
    "image": "ghcr.io/smart-social-contracts/realms:ui-test-latest",
    "container_name_prefix": "passport-verification-test",
    "port_mapping": {
      "host_port": 8004,
      "container_port": 8000
    }
  },

  "environment": {
    "PLAYWRIGHT_BASE_URL": "http://localhost:8000",
    "E2E_WARMUP_PATH": "/extensions/passport_verification"
  }
}
